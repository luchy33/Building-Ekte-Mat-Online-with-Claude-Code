<bpmn:textAnnotation id="Ann_legend"><bpmn:text>Blue = supported by Ekte Mat Online. [US-xx] = user story in 01_Requirements/EkteMat_backlog_v1.xlsx.</bpmn:text></bpmn:textAnnotation>
<bpmn:textAnnotation id="Ann_dep"><bpmn:text>Deposit scope is unresolved: all bookings or weddings only? (ISS-01)</bpmn:text></bpmn:textAnnotation>
<bpmn:textAnnotation id="Ann_phone"><bpmn:text>Phone and e-mail orders are entered by the coordinator into the same order record (US-09; ISS-12).</bpmn:text></bpmn:textAnnotation>
<bpmn:textAnnotation id="Ann_owner"><bpmn:text>No per-order task: the monthly manual reconciliation is replaced by the Fiken integration (US-24, INFERRED).</bpmn:text></bpmn:textAnnotation>
<bpmn:association id="Ann_dep_assoc" sourceRef="Ann_dep" targetRef="s_gwdep" />
